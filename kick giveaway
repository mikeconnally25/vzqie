  users: Participant[],
  count: number
) {

  const winners = [];
  const pool = [...users];

  while (
    winners.length < count &&
    pool.length
  ) {

    const index =
      Math.floor(
        Math.random() * pool.length
      );

    winners.push(
      pool.splice(index, 1)[0]
    );
  }

  return winners;
